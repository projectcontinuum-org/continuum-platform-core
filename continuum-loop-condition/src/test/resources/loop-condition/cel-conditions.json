{
  "about": "Loop conditions in full CEL: which texts the validator accepts (with the checked result type and the flow variables read with a literal key) or rejects (with the issue code and 1-based column), and what the evaluator returns for given flow variables. The validator and evaluator tests of continuum-loop-condition run every row.",
  "format": {
    "id": "descriptive, unique",
    "input": "the condition text",
    "valid": "true when the validator accepts it",
    "code": "invalid rows: the LoopConditionIssueCode",
    "column": "invalid rows, optional: the 1-based column of the issue",
    "resultType": "valid rows: bool or dyn",
    "readsVariables": "valid rows: the flow variable names read with a literal key, sorted",
    "source": "optional: builder for texts the workbench query builder emits",
    "evaluations": "valid rows, optional: vars (flow variables as JSON), onNonBooleanResult (fail or treat-as-false, default fail), expect (true, false, non-boolean or a runtime issue code), messageContains (optional text of the message)"
  },
  "rows": [
    {
      "id": "equality-with-true",
      "input": "vars[\"hasMore\"] == true",
      "valid": true,
      "resultType": "bool",
      "readsVariables": [
        "hasMore"
      ],
      "evaluations": [
        {
          "vars": {
            "hasMore": true
          },
          "expect": true
        },
        {
          "vars": {
            "hasMore": false
          },
          "expect": false
        },
        {
          "vars": {},
          "expect": "MISSING_VARIABLE",
          "messageContains": "'hasMore'"
        },
        {
          "vars": {
            "hasMore": "yes"
          },
          "expect": false
        }
      ]
    },
    {
      "id": "and-of-two-variables",
      "input": "vars[\"page\"] < 10 && vars[\"hasMore\"]",
      "valid": true,
      "resultType": "bool",
      "readsVariables": [
        "hasMore",
        "page"
      ],
      "evaluations": [
        {
          "vars": {
            "page": 3,
            "hasMore": true
          },
          "expect": true
        },
        {
          "vars": {
            "page": 12,
            "hasMore": true
          },
          "expect": false
        },
        {
          "vars": {
            "page": 3,
            "hasMore": "yes"
          },
          "expect": "EVALUATION_ERROR",
          "messageContains": "expected boolean"
        }
      ]
    },
    {
